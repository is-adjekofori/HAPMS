# Used by docker-compose.yml to run the whole stack (MySQL + backend +
# frontend) with one `docker compose up -d` (or `podman compose up -d`).
# Copy to .env at the repo root and adjust if needed — every value below has
# a working default baked into docker-compose.yml itself.

MYSQL_DATABASE=hapms
MYSQL_USER=hapms
MYSQL_PASSWORD=hapms
MYSQL_ROOT_PASSWORD=hapms_root
MYSQL_PORT=3306

BACKEND_PORT=8000
# Dev-only placeholder — generate a real one per environment with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b
JWT_EXPIRY_MINUTES=480

FRONTEND_PORT=3000
# Must be the browser-reachable backend URL (baked into the frontend build),
# not the internal `backend:8000` compose hostname.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
